{
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/young-cat-media.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "redirects": [
    { "source": "/picky-eaters.html", "destination": "/picky-eaters", "permanent": true },
    { "source": "/paid-consult.html", "destination": "/paid-consult", "permanent": true },
    { "source": "/free-consult.html", "destination": "/free-consult", "permanent": true }
  ],
  "rewrites": [
    { "source": "/skin", "destination": "/index.html" },
    { "source": "/coat", "destination": "/index.html" },
    { "source": "/skin-and-coat", "destination": "/index.html" },
    { "source": "/eating", "destination": "/index.html" },
    { "source": "/eating-less", "destination": "/index.html" },
    { "source": "/appetite", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy-policy", "destination": "/privacy.html" },
    { "source": "/picky-eaters", "destination": "/picky-eaters.html" },
    { "source": "/paid-consult", "destination": "/paid-consult.html" },
    { "source": "/free-consult", "destination": "/free-consult.html" },
    { "source": "/follow-up", "destination": "/index.html" },
    { "source": "/followup", "destination": "/index.html" },
    { "source": "/again", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|webp|jpg|jpeg|png|svg|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
